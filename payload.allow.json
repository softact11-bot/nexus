  "tracker/config.js", "tracker/cc.js", "tracker/knowledge.js", "tracker/syncview.js", "tracker/sync.js", "tracker/graph.js", "tracker/auto.js",
  "tracker/accounts.js", "tracker/keyring.ps1", "tracker/assist.js", "tracker/brain.js", "tracker/watch.js", "tracker/voice.js", "tracker/voice.ps1", "tracker/scan.js", "tracker/savings.js",
  "tracker/catalog.js", "tracker/pluginops.js",
  "tracker/dashboard.html", "tracker/tips.txt", "tracker/config.example.json",
  "tracker/app/*.html", "tracker/app/css/*.css", "tracker/app/fonts/*", "tracker/app/img/*", "tracker/app/js/*.js", "tracker/app/js/bg/*.js", "tracker/app/js/core/*.js", "tracker/app/js/pages/*.js",
